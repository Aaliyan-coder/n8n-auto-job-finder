    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const raw = $json.text ?? '';\nlet cleaned = raw\n  .replace(/<think>[\\s\\S]*?<\\/think>/g, '')\n  .replace(/```json/gi, '')\n  .replace(/```/g, '')\n  .trim();\n\nconst job = $('Find & Score Jobs').item.json;\nlet subject = '';\nlet body = '';\n\nconst start = cleaned.indexOf('{');\nconst end = cleaned.lastIndexOf('}');\nif (start !== -1 && end !== -1) {\n  try {\n    const parsed = JSON.parse(cleaned.slice(start, end + 1));\n    subject = parsed.email_subject ?? '';\n    body = parsed.email_body ?? '';\n  } catch (e) { /* fall through to fallback */ }\n}\n\nif (!subject) subject = 'Application: ' + job.job_title + ' at ' + job.company;\nif (!body) body = cleaned;\n\nbody = 'Apply here: ' + (job.apply_url || 'n/a') + '\\n\\n' + body;\n\nreturn { json: {\n  email_subject: subject,\n  email_body: body,\n  job_title: job.job_title,\n  company: job.company,\n  apply_url: job.apply_url,\n  contact_email: job.contact_email ?? '',\n  keyword_hits: job.keyword_hits\n} };"
      },
