    {
      "parameters": {
        "jsCode": "const keywords = ['python', 'react', 'ai', 'ml', 'machine learning', 'fastapi', 'django', 'full stack', 'llm', 'data'];\nlet jobs = [];\n\nfor (const item of $input.all()) {\n  // Remotive: { jobs: [...] }\n  if (Array.isArray(item.json.jobs)) {\n    for (const j of item.json.jobs) {\n      jobs.push({\n        job_title: j.title ?? '',\n        company: j.company_name ?? '',\n        job_description: (j.description ?? '').replace(/<[^>]*>/g, ' ').slice(0, 2500),\n        apply_url: j.url ?? '',\n      });\n    }\n  }\n  // JSearch v2: { data: { jobs: [...] } }\n  if (item.json.data && Array.isArray(item.json.data.jobs)) {\n    for (const j of item.json.data.jobs) {\n      jobs.push({\n        job_title: j.job_title ?? '',\n        company: j.employer_name ?? '',\n        job_description: (j.job_description ?? '').replace(/<[^>]*>/g, ' ').slice(0, 2500),\n        apply_url: j.job_apply_link ?? '',\n      });\n    }\n  }\n  // Arbeitnow: { data: [...] }\n  if (Array.isArray(item.json.data)) {\n    for (const j of item.json.data) {\n      jobs.push({\n        job_title: j.title ?? '',\n        company: j.company_name ?? '',\n        job_description: (j.description ?? '').replace(/<[^>]*>/g, ' ').slice(0, 2500),\n        apply_url: j.url ?? '',\n      });\n    }\n  }\n}\n\nconst scored = jobs.map(j => {\n  const text = (j.job_title + ' ' + j.job_description).toLowerCase();\n  const hits = keywords.filter(k => text.includes(k)).length;\n  return { ...j, keyword_hits: hits };\n})\n.filter(j => j.keyword_hits >= 2)\n.sort((a, b) => b.keyword_hits - a.keyword_hits);\n\nconst seen = new Set();\nconst unique = [];\nfor (const j of scored) {\n  const key = j.job_title + '|' + j.company;\n  if (!seen.has(key)) { seen.add(key); unique.push(j); }\n}\n\nreturn unique.slice(0, 10).map(j => {\n  const m = j.job_description.match(/[\\w.+-]+@[\\w-]+\\.[\\w.]+/);\n  return { json: { ...j, contact_email: m ? m[0] : '' } };\n});"
      },
      "name": "Find & Score Jobs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
